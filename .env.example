# PostgreSQL
POSTGRES_DB=relayforge
POSTGRES_USER=relayforge
POSTGRES_PASSWORD=relayforge
POSTGRES_PORT=5435

# Used by the application when run outside Docker.
DATABASE_URL=postgres://relayforge:relayforge@localhost:5435/relayforge?sslmode=disable

# API
APP_ENV=development
API_PORT=8080
HTTP_ADDR=:8080
SESSION_TTL=720h
# Required when APP_ENV=production. Use a long random value.
API_KEY_PEPPER=relayforge-development-pepper
# Falls back to API_KEY_PEPPER when empty.
WORKER_TOKEN_PEPPER=
RATE_LIMIT_AUTH_PER_MINUTE=20
RATE_LIMIT_API_PER_MINUTE=600
RATE_LIMIT_JOB_SUBMIT_PER_MINUTE=120

# Worker
# Set to the UUID of the project this worker processes.
WORKER_PROJECT_ID=
# Project worker token created in the dashboard or via the API.
WORKER_TOKEN=
WORKER_NAME=relayforge-worker
WORKER_CONCURRENCY=4
WORKER_POLL_INTERVAL=1s
JOB_TIMEOUT=5m
WORKER_SHUTDOWN_TIMEOUT=30s
WORKER_HEARTBEAT_INTERVAL=15s
WORKER_CLEANUP_INTERVAL=1h
RETRY_BASE_DELAY=5s
RETRY_MAX_DELAY=5m
