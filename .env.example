# PostgreSQL
POSTGRES_DB=relayforge
POSTGRES_USER=relayforge
POSTGRES_PASSWORD=relayforge
POSTGRES_PORT=5435

# Used by the application when run outside Docker.
DATABASE_URL=postgres://relayforge:relayforge@localhost:5435/relayforge?sslmode=disable

# API
APP_ENV=development
API_PORT=8080
HTTP_ADDR=:8080
SESSION_TTL=720h
# Generate independent secrets with:
#   openssl rand -hex 32
# Required when APP_ENV=production (>= 32 characters, and the two must differ).
# In development an unset API_KEY_PEPPER falls back to a local-development value.
API_KEY_PEPPER=change-me-use-openssl-rand-hex-32
# Falls back to API_KEY_PEPPER in development. Required in production.
WORKER_TOKEN_PEPPER=change-me-use-a-different-openssl-value
# open | invite | closed. Production defaults to invite and rejects open.
REGISTRATION_MODE=open
# First account registered with this email becomes an administrator. In invite
# mode this email may register without an invite.
BOOTSTRAP_ADMIN_EMAIL=
INVITE_TTL=168h
# Quotas. 0 disables a limit.
MAX_PROJECTS_PER_USER=5
MAX_WORKER_POOLS_PER_PROJECT=10
MAX_ACTIVE_POOLS_PER_PROJECT=5
MAX_WORKER_CONCURRENCY_PER_PROJECT=50
MAX_QUEUED_JOBS_PER_PROJECT=100000
# Cron schedules per project, and how often the API evaluates them.
MAX_SCHEDULES_PER_PROJECT=50
API_SCHEDULER_INTERVAL=15s
# Prometheus metrics listener (internal only).
METRICS_ENABLED=true
METRICS_ADDR=:9090

# Production TLS reverse proxy (compose.production.yaml)
SITE_ADDRESS=localhost
RATE_LIMIT_AUTH_PER_MINUTE=20
RATE_LIMIT_API_PER_MINUTE=600
RATE_LIMIT_JOB_SUBMIT_PER_MINUTE=120

# Worker
# direct (PostgreSQL) or remote (API only). Auto: direct when DATABASE_URL is set.
WORKER_MODE=
# Set to the UUID of the project this worker processes.
WORKER_PROJECT_ID=
# Project worker token created in the dashboard or via the API.
WORKER_TOKEN=
# Cached token written after enrollment; reused across restarts.
WORKER_TOKEN_FILE=.relayforge/worker-token.json
# Single-use bootstrap token created for a worker pool. Takes over when no
# WORKER_TOKEN is set and the token file is missing or invalid.
WORKER_ENROLLMENT_TOKEN=
RELAYFORGE_API_URL=http://localhost:8080
WORKER_ENROLLMENT_TTL=15m
WORKER_NAME=relayforge-worker
WORKER_CONCURRENCY=4
WORKER_POLL_INTERVAL=1s
JOB_TIMEOUT=5m
WORKER_SHUTDOWN_TIMEOUT=30s
WORKER_HEARTBEAT_INTERVAL=15s
WORKER_CLEANUP_INTERVAL=1h
RETRY_BASE_DELAY=5s
RETRY_MAX_DELAY=5m
# Extra time beyond the job timeout before a remote worker lease expires.
WORKER_LEASE_GRACE=60s
# Optional local secrets file (JSON object of env name -> value).
WORKER_SECRETS_FILE=
# Comma-separated outbound host allowlist for handlers using the shared client.
WORKER_EGRESS_ALLOWLIST=
# Built-in handlers refuse loopback, private, and link-local destinations unless
# this is true. Enable it only for intentionally internal webhooks.
WORKER_ALLOW_PRIVATE_EGRESS=false
# Default timeout for http.request and notification calls.
ACTION_HTTP_TIMEOUT=30s

# Email relay used by notify.email (operator-provided).
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=
# starttls | tls | none
SMTP_TLS=starttls

# Default notification destinations. Per-job payloads may override them.
SLACK_WEBHOOK_URL=
DISCORD_WEBHOOK_URL=
TELEGRAM_BOT_TOKEN=
# Twilio credentials used by notify.sms.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
# Header injected by a trusted proxy after mTLS termination.
WORKER_MTLS_HEADER=

# API background jobs and remote worker security
API_OUTBOX_INTERVAL=1s
API_CLEANUP_INTERVAL=1h
API_REAPER_INTERVAL=15s
API_WORKER_SWEEP_INTERVAL=30s
WORKER_STALE_AFTER=90s
TOKEN_ROTATION_GRACE=24h
# Only enable behind a trusted reverse proxy.
TRUST_PROXY_HEADERS=false

# Worker pool supervisor
SUPERVISOR_POLL_INTERVAL=5s
SUPERVISOR_WORKER_BINARY=relayforge-worker
SUPERVISOR_TOKEN_DIR=.relayforge/worker-tokens
